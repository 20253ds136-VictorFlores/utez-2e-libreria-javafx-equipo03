<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.resources.integradorabiblioteca.controllers.DetailControllers"
      spacing="12" alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Detalle del Libro"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <Label fx:id="lblIsbn"/>
    <Label fx:id="lblTitulo"/>
    <Label fx:id="lblAutor"/>
    <Label fx:id="lblAnio"/>
    <Label fx:id="lblGenero"/>
    <Label fx:id="lblDisponible"/>

    <Button text="Regresar" style="-fx-background-color: lightblue; -fx-font-weight: bold;" onAction="#onRegresar"/>
</VBox>