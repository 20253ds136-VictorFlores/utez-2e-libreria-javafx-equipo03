<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.resources.integradorabiblioteca.controllers.DetailControllers"
      spacing="15" alignment="CENTER" prefWidth="550" prefHeight="650">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Detalles del Libro" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <GridPane vgap="8" hgap="15" alignment="CENTER">
        <Label text="ISBN:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblIsbn" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Título:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblTitulo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Autor:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblAutor" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Año:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblAnio" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Género:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblGenero" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Disponible:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblDisponible" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <Label text="Añadir una reseña" style="-fx-font-weight: bold;"/>
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtCalificacion" promptText="Calificación (1-5)" prefWidth="120"/>
        <TextField fx:id="txtComentario" promptText="Comentario..." HBox.hgrow="ALWAYS"/>
        <Button text="Publicar" onAction="#onAgregarResena" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <TableView fx:id="tablaResenas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="100"/>
            <TableColumn fx:id="colCalificacion" text="Estrellas" prefWidth="80"/>
            <TableColumn fx:id="colComentario" text="Comentario" prefWidth="300"/>
        </columns>
    </TableView>

    <Button text="Regresar" onAction="#onRegresar" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>

</VBox>