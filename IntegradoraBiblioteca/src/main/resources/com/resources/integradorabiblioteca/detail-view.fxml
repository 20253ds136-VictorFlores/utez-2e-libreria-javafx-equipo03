<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="550.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.resources.integradorabiblioteca.controllers.DetailControllers">
    <children>
        <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Detalles del Libro" textFill="#333333">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>

                <GridPane hgap="15.0" vgap="10.0" maxWidth="450.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <children>
                        <Label text="ISBN:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                        <Label fx:id="lblIsbn" text="ISBN: ..." GridPane.columnIndex="1" />
                        <Label text="Título:" style="-fx-font-weight: bold; -fx-font-size: 14px;" GridPane.rowIndex="1" />
                        <Label fx:id="lblTitulo" text="Título: ..." GridPane.columnIndex="1" GridPane.rowIndex="1" wrapText="true" />
                        <Label text="Autor:" style="-fx-font-weight: bold; -fx-font-size: 14px;" GridPane.rowIndex="2" />
                        <Label fx:id="lblAutor" text="Autor: ..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Año:" style="-fx-font-weight: bold; -fx-font-size: 14px;" GridPane.rowIndex="3" />
                        <Label fx:id="lblAnio" text="Año: ..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Género:" style="-fx-font-weight: bold; -fx-font-size: 14px;" GridPane.rowIndex="4" />
                        <Label fx:id="lblGenero" text="Género: ..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <Label text="Disponible:" style="-fx-font-weight: bold; -fx-font-size: 14px;" GridPane.rowIndex="5" />
                        <Label fx:id="lblDisponible" text="Disponible: ..." GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </children>
                </GridPane>

                <Separator />
                <Label text="Añadir una reseña" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <TextField fx:id="txtNuevaEstrella" prefHeight="35.0" prefWidth="80.0" style="-fx-border-color: #3182ce; -fx-border-width: 2;" />
                        <TextField fx:id="txtNuevaResena" prefHeight="35.0" promptText="Comentario..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#onPublicarClick" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Publicar" />
                    </children>
                </HBox>

                <TableView fx:id="tableResenas" prefHeight="250.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEstrellas" prefWidth="100.0" text="Estrellas" />
                        <TableColumn fx:id="colComentario" prefWidth="350.0" text="Comentario" />
                    </columns>
                </TableView>

                <Button onAction="#onRegresarClick" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Regresar" />
            </children>
        </VBox>
    </children>
</AnchorPane>