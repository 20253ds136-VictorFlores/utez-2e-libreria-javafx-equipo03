<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.resources.integradorabiblioteca.controllers.FormControllers"
      style="-fx-padding: 25; -fx-background-color: white;">

    <Label text="Información del Libro" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane vgap="10" hgap="10">
        <Label text="ISBN:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIsbn" promptText="Ej: 978-..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Título:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitulo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Autor:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAutor" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Año:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAnio" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Género:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtGenero" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Disponible:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <CheckBox fx:id="chkDisponible" GridPane.rowIndex="5" GridPane.columnIndex="1" selected="true"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancelar" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
        <Button text="Guardar Libro" onAction="#onGuardar" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>