<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.resources.integradorabiblioteca.controllers.MainControllers">
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Catálogo de Libros" />
   <GridPane prefHeight="33.0" prefWidth="469.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="402" minWidth="10.0" prefWidth="56" />
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="758" minWidth="10.0" prefWidth="758" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
          <TextField fx:id="txtBusqueda" prefHeight="25.0" prefWidth="184.0" promptText="Buscar por titulo o ISBN" GridPane.columnIndex="1" />
         <Label text="Buscador:" />
      </children>
   </GridPane>
    <TableView fx:id="tableBooks" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIsbn" prefWidth="120" text="ISBN / ID" />
            <TableColumn fx:id="colTitulo" prefWidth="220" text="Titulo" />
            <TableColumn fx:id="colAutor" prefWidth="180" text="Autor" />
            <TableColumn fx:id="colAnio" prefWidth="80" text="Año" />
            <TableColumn fx:id="colGenero" prefWidth="120" text="Genero" />
            <TableColumn fx:id="colDisponible" prefWidth="90" text="Disponible" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="15">
        <Button onAction="#onNewClick" text="Nuevo Registro" />
        <Button onAction="#onEditClick" text="Editar Seleccionado" />
        <Button onAction="#onDeleteClick" style="-fx-text-fill: red;" text="Eliminar Registro" />
        <Button onAction="#onDetailClick" text="Ver Detalles" />
        <Button onAction="#onExportClick" text="Exportar a CSV" />
    </HBox>
</VBox>
