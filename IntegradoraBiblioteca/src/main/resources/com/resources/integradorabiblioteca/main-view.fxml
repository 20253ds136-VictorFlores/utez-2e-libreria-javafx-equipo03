<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="com.resources.integradorabiblioteca.controllers.MainControllers" style="-fx-padding: 20;">
    <Label text="Catálogo de Libros" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TableView fx:id="tableBooks" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIsbn" text="ISBN / ID" prefWidth="120"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="220"/>
            <TableColumn fx:id="colAutor" text="Autor" prefWidth="180"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="80"/>
            <TableColumn fx:id="colGenero" text="Género" prefWidth="120"/>
            <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Nuevo Registro" onAction="#onNewClick"/>
        <Button text="Editar Seleccionado" onAction="#onEditClick"/>
        <Button text="Eliminar Registro" onAction="#onDeleteClick" style="-fx-text-fill: red;"/>
        <Button text="Ver Detalles" onAction="#onDetailClick"/>
        <Button text="Exportar a CSV" onAction="#onExportClick"/>
    </HBox>
</VBox>
